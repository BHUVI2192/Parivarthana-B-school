<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /BSchool/

  # Pass Authorization Header to PHP on cPanel / Apache / FastCGI
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

  # Allow direct access to API requests
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^api/(.*)$ api/$1 [L,QSA]

  # Allow direct access to uploaded files
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^uploads/(.*)$ uploads/$1 [L]

  # Direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all other SPA routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>
